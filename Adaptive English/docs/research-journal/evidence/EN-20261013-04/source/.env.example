# ==============================================================================
# BẢNG CẤU HÌNH MẪU CHO MÔI TRƯỜNG VẬN HÀNH (ADAPTIVE ENGLISH / ADAPTIVE STUDY)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env.local trong thư mục english-learning-platform/
# TUYỆT ĐỐI KHÔNG ghi các mã khóa bảo mật thật vào tệp .env.example này.

# ------------------------------------------------------------------------------
# 1. Cấu hình Cơ bản & Môi trường Chạy (Server Environment)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Khóa bí mật ký phiên mã hóa (Tối thiểu 32 ký tự ngẫu nhiên bảo mật)
# Sinh ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_secure_random_32_bytes_hex_string

# ------------------------------------------------------------------------------
# 2. Cơ sở Dữ liệu (Prisma & SQLite)
# ------------------------------------------------------------------------------
# Mặc định sử dụng SQLite cục bộ. Trên máy chủ production, đường dẫn tệp DB
# PHẢI nằm trên phân vùng lưu trữ bền vững (Persistent Storage / Volume),
# KHÔNG triển khai vào thư mục tạm có thể bị xóa khi restart container/process.
DATABASE_URL=file:./dev.db

# ------------------------------------------------------------------------------
# 3. Dịch vụ AI (Trợ lý Học tập Socratic Tutor & Chấm điểm Tự luận)
# ------------------------------------------------------------------------------
# API Key của nhà cung cấp dịch vụ LLM (ví dụ: Claude / OpenAI / Gemini / MWAPI)
# Nếu để trống hoặc chưa cấu hình, hệ thống sẽ tự động chuyển sang chế độ Rule-Based
# an toàn và minh bạch thông báo trạng thái ngoại tuyến cho người dùng.
MWAPI_API_KEY=
MWAPI_BASE_URL=https://api.mwapi.dev
MWAPI_MODEL=claude-sonnet-4-6

# ------------------------------------------------------------------------------
# 4. Cấu hình Dịch vụ Gửi Email (SMTP Service - Khôi phục Mật khẩu Thật)
# ------------------------------------------------------------------------------
# Cần cấu hình để gửi email kích hoạt và khôi phục mật khẩu thực tế tới hòm thư người dùng.
# Nếu chưa khai báo các biến này, hệ thống sẽ chuyển sang chế độ kiểm thử nội bộ (testResetLink)
# và ghi nhận trạng thái gửi email thật là BLOCKED (Pending SMTP setup).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Adaptive English <noreply@yourdomain.edu.vn>"

# OTP đăng ký dùng Resend (độc lập với SMTP khôi phục mật khẩu ở trên).
# Chỉ điền giá trị thật trong cấu hình máy chủ, không commit vào file này.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
REGISTRATION_OTP_SECRET=

# ------------------------------------------------------------------------------
# 5. Cờ Kiểm Soát Phát Triển (Development & Demo Flags)
# ------------------------------------------------------------------------------
# TUYỆT ĐỐI ĐẶT LÀ false TRÊN MÔI TRƯỜNG PRODUCTION.
# Khi đặt false: Bộ chuyển đổi vai trò (RoleSwitcher) và đăng nhập nhanh không mật khẩu
# sẽ bị vô hiệu hóa hoàn toàn cả ở tầng API (/api/auth/switch-role trả về HTTP 403)
# lẫn tầng giao diện người dùng.
ENABLE_ROLE_SWITCHER=false
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=false
